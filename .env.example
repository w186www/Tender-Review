APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/bidding_compliance
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=bidding-compliance
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_ROOT=data/runtime/objects
# staging/production 使用 s3；ACCESS_ID/ACCESS_SECRET 从秘密服务注入，不写入模板。
# OBJECT_STORAGE_ACCESS_ID / OBJECT_STORAGE_ACCESS_SECRET
# PARSER_IMAGE 为 docker image inspect 返回的固定 sha256 镜像ID；无默认标签。
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=20
CLAMD_MAX_DATABASE_AGE_SECONDS=604800
MODEL_PROFILE=local-development
AUTH_ISSUER=bidding-compliance
AUTH_AUDIENCE=bidding-api
AUTH_TTL_SECONDS=900
# AUTH_SIGNING_KEY 由随机生成的运行环境秘密提供（至少32字节），不设置默认密钥。
# 真实密钥只通过 Secret Manager 或本地未提交的 .env 注入。
# health只检查服务存活；业务接口需要先迁移、引导账号并配置数据库和签名密钥。

