# Legacy source hashes and character offsets were captured from CRLF files.
# Pin checkout bytes on every platform; newer immutable artifacts stay binary below.
knowledge/legal/**/*.txt text eol=crlf
knowledge/legal/snapshots/** -text -diff
knowledge/legal/versions/** -text

# Biome enforces LF formatting; keep all checked-in frontend files deterministic across platforms.
src/frontend/** text eol=lf

# Deployment shell scripts run on Linux hosts and inside containers; CRLF breaks bash parsing.
deploy/*.sh text eol=lf
