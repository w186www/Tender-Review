# Build the existing React workbench and serve it with nginx.
# VITE_REVIEW_MODE is a compile-time switch of the repository's own UI (see src/frontend/src/app.tsx);
# it must match the review mode the API container actually runs, so the on-page notice stays truthful.
# Values: offline-deterministic (default) | online-qwen | dec005-real-qwen | dec007-real-qwen
# (dec007-real-qwen is the DEC-007 full-capability notice: per-file approved documents and the
# prebuilt full vector index; the notice states the authorization scope on the page).
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build

ARG VITE_REVIEW_MODE=offline-deterministic
ENV VITE_REVIEW_MODE=${VITE_REVIEW_MODE} \
    CI=1

WORKDIR /workbench
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

COPY deploy/nginx-demo.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-locations.inc /etc/nginx/includes/locations.inc
COPY --from=build /workbench/dist /usr/share/nginx/html

EXPOSE 8080
