{
  "additionalProperties": false,
  "description": "Caller-pinned document versions; service reads content from trusted storage.",
  "properties": {
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "raw_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Source Sha256",
      "type": "string"
    },
    "parse_version": {
      "minimum": 1,
      "title": "Parse Version",
      "type": "integer"
    },
    "context_version": {
      "minimum": 1,
      "title": "Context Version",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "raw_source_sha256",
    "parse_version",
    "context_version"
  ],
  "title": "DiscoveryDocumentRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/candidate-discovery-document-request.schema.json"
}
