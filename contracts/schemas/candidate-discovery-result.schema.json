{
  "$defs": {
    "CandidateFinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "skill_id": {
                "type": "string"
              },
              "skill_version": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "rule_version": {
                "type": "string"
              }
            },
            "required": [
              "skill_id",
              "skill_version",
              "rule_id",
              "rule_version"
            ]
          },
          "if": {
            "properties": {
              "origin": {
                "const": "model"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "skill_id": {
                "type": "null"
              },
              "skill_version": {
                "type": "null"
              },
              "rule_id": {
                "type": "null"
              },
              "rule_version": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "candidate_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "qualification",
            "technical",
            "evaluation",
            "contract",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "default": "rule",
          "enum": [
            "rule",
            "model"
          ],
          "title": "Origin",
          "type": "string"
        },
        "skill_id": {
          "anyOf": [
            {
              "enum": [
                "qualification_review",
                "technical_review",
                "evaluation_review",
                "contract_review",
                "procedure_review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "skill_version": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Version"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule_version": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "document_version_ref": {
          "pattern": "^doc-version:sha256:[a-f0-9]{64}$",
          "title": "Document Version Ref",
          "type": "string"
        },
        "problem_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Problem Key",
          "type": "string"
        },
        "deduplication_key": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Deduplication Key",
          "type": "string"
        },
        "source_excerpts": {
          "items": {
            "$ref": "#/$defs/SourceExcerpt"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Excerpts",
          "type": "array"
        },
        "matched_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Matched Reason",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/CandidateSource"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "category",
        "document_version_ref",
        "problem_key",
        "deduplication_key",
        "source_excerpts",
        "matched_reason",
        "provenance"
      ],
      "title": "CandidateFinding",
      "type": "object"
    },
    "CandidateSource": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "skill_id": {
                "type": "string"
              },
              "skill_version": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "rule_version": {
                "type": "string"
              },
              "model_provenance": {
                "type": "null"
              }
            },
            "required": [
              "skill_id",
              "skill_version",
              "rule_id",
              "rule_version"
            ]
          },
          "if": {
            "properties": {
              "origin": {
                "const": "model"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "skill_id": {
                "type": "null"
              },
              "skill_version": {
                "type": "null"
              },
              "rule_id": {
                "type": "null"
              },
              "rule_version": {
                "type": "null"
              },
              "model_provenance": {
                "type": "object"
              }
            },
            "required": [
              "model_provenance"
            ]
          }
        }
      ],
      "properties": {
        "origin": {
          "default": "rule",
          "enum": [
            "rule",
            "model"
          ],
          "title": "Origin",
          "type": "string"
        },
        "skill_id": {
          "anyOf": [
            {
              "enum": [
                "qualification_review",
                "technical_review",
                "evaluation_review",
                "contract_review",
                "procedure_review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "skill_version": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Version"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule_version": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "model_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCandidateProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_excerpts": {
          "items": {
            "$ref": "#/$defs/SourceExcerpt"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Excerpts",
          "type": "array"
        },
        "matched_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Matched Reason",
          "type": "string"
        }
      },
      "required": [
        "source_excerpts",
        "matched_reason"
      ],
      "title": "CandidateSource",
      "type": "object"
    },
    "DiscoveryInputSnapshot": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "project_version": {
          "minimum": 1,
          "title": "Project Version",
          "type": "integer"
        },
        "project_context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Project Context Sha256",
          "type": "string"
        },
        "project_context_ref": {
          "pattern": "^project-version:sha256:[a-f0-9]{64}$",
          "title": "Project Context Ref",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentVersionRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "project_version",
        "project_context_sha256",
        "project_context_ref",
        "documents"
      ],
      "title": "DiscoveryInputSnapshot",
      "type": "object"
    },
    "DocumentVersionRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "raw_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Source Sha256",
          "type": "string"
        },
        "parse_version": {
          "minimum": 1,
          "title": "Parse Version",
          "type": "integer"
        },
        "context_version": {
          "minimum": 1,
          "title": "Context Version",
          "type": "integer"
        },
        "fragments_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fragments Sha256",
          "type": "string"
        },
        "ocr_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/OCRRuntimeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ocr_runtime_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Runtime Sha256"
        },
        "document_version_ref": {
          "pattern": "^doc-version:sha256:[a-f0-9]{64}$",
          "title": "Document Version Ref",
          "type": "string"
        },
        "fragment_count": {
          "minimum": 1,
          "title": "Fragment Count",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "raw_source_sha256",
        "parse_version",
        "context_version",
        "fragments_sha256",
        "document_version_ref",
        "fragment_count"
      ],
      "title": "DocumentVersionRef",
      "type": "object"
    },
    "JsonValue": {},
    "ModelCandidateProvenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "response_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Response Hash",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "response_hash"
      ],
      "title": "ModelCandidateProvenance",
      "type": "object"
    },
    "OCRRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "v1alpha1",
          "default": "v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "engine_id": {
          "const": "tesseract",
          "default": "tesseract",
          "title": "Engine Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Model Ids",
          "type": "array"
        },
        "model_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Sha256",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parser_image_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Image Sha256"
        },
        "identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        }
      },
      "required": [
        "engine_version",
        "model_ids",
        "model_sha256",
        "parameters",
        "identity_sha256"
      ],
      "title": "OCRRuntimeIdentity",
      "type": "object"
    },
    "RetrievalTopic": {
      "additionalProperties": false,
      "properties": {
        "topic_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        },
        "skill_id": {
          "enum": [
            "qualification_review",
            "technical_review",
            "evaluation_review",
            "contract_review",
            "procedure_review"
          ],
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
          "title": "Skill Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "qualification",
            "technical",
            "evaluation",
            "contract",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "query_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "source_rules": {
          "items": {
            "$ref": "#/$defs/RuleReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Rules",
          "type": "array"
        }
      },
      "required": [
        "topic_id",
        "skill_id",
        "skill_version",
        "category",
        "query_text",
        "source_rules"
      ],
      "title": "RetrievalTopic",
      "type": "object"
    },
    "RuleReference": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version"
      ],
      "title": "RuleReference",
      "type": "object"
    },
    "SkillCoverage": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "enum": [
            "qualification_review",
            "technical_review",
            "evaluation_review",
            "contract_review",
            "procedure_review"
          ],
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
          "title": "Skill Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "qualification",
            "technical",
            "evaluation",
            "contract",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed_no_candidates",
            "completed_with_candidates",
            "not_applicable",
            "incomplete",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "scanned_documents": {
          "items": {
            "$ref": "#/$defs/DocumentVersionRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Scanned Documents",
          "type": "array"
        },
        "evaluated_rules": {
          "items": {
            "$ref": "#/$defs/RuleReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evaluated Rules",
          "type": "array"
        },
        "candidates_found": {
          "minimum": 0,
          "title": "Candidates Found",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "unsupported_score_table",
                "ambiguous_score_table",
                "ambiguous_tender_times",
                "inconsistent_timezones",
                "missing_timezone",
                "ambiguous_technical_requirement",
                "rule_execution_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "skill_id",
        "skill_version",
        "category",
        "status",
        "scanned_documents",
        "evaluated_rules",
        "candidates_found"
      ],
      "title": "SkillCoverage",
      "type": "object"
    },
    "SourceExcerpt": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "section_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "section_revision": {
          "minimum": 1,
          "title": "Section Revision",
          "type": "integer"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "coordinate_system": {
          "enum": [
            "pdf_points",
            "image_pixels",
            "ooxml"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "quote": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "document_sha256",
        "section_id",
        "section_revision",
        "locator",
        "coordinate_system",
        "quote",
        "quote_sha256"
      ],
      "title": "SourceExcerpt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1alpha1",
      "default": "v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "engine_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Engine Version",
      "type": "string"
    },
    "input_snapshot": {
      "$ref": "#/$defs/DiscoveryInputSnapshot"
    },
    "ruleset_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ruleset Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "completed_with_incomplete_skill",
        "completed_with_failed_skill"
      ],
      "title": "Status",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateFinding"
      },
      "maxItems": 10000,
      "title": "Candidates",
      "type": "array"
    },
    "skill_coverages": {
      "items": {
        "$ref": "#/$defs/SkillCoverage"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Skill Coverages",
      "type": "array"
    },
    "retrieval_topics": {
      "items": {
        "$ref": "#/$defs/RetrievalTopic"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Retrieval Topics",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Sha256",
      "type": "string"
    }
  },
  "required": [
    "input_snapshot",
    "ruleset_sha256",
    "status",
    "candidates",
    "skill_coverages",
    "retrieval_topics",
    "result_sha256"
  ],
  "title": "DiscoveryResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/candidate-discovery-result.schema.json"
}
