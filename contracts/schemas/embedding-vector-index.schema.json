{
  "$defs": {
    "EmbeddingModelIdentity": {
      "additionalProperties": false,
      "description": "Pinned provider/model contract used to keep vector spaces isolated.",
      "properties": {
        "schema_version": {
          "const": "v1alpha1",
          "default": "v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "pattern": "^[a-z][a-z0-9_-]{0,49}$",
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "pattern": "^[a-z][a-z0-9-]{0,49}$",
          "title": "Region",
          "type": "string"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "dimensions": {
          "anyOf": [
            {
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "tokenizer_identity": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tokenizer Identity",
          "type": "string"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        },
        "tokenizer_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Sha256"
        },
        "api_contract_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Api Contract Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "region",
        "model_id",
        "model_revision",
        "tokenizer_identity",
        "api_contract_version",
        "identity_sha256"
      ],
      "title": "EmbeddingModelIdentity",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Content-addressed description of a complete vector index (vectors stay in SQLite).",
  "properties": {
    "schema_version": {
      "const": "v1alpha1",
      "default": "v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "build_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Build Id",
      "type": "string"
    },
    "build_version": {
      "const": "sqlite-exact-cosine-f32le-v1",
      "default": "sqlite-exact-cosine-f32le-v1",
      "title": "Build Version",
      "type": "string"
    },
    "legal_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Legal Snapshot Sha256",
      "type": "string"
    },
    "publication_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "embedding_identity": {
      "$ref": "#/$defs/EmbeddingModelIdentity"
    },
    "item_count": {
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "items_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Items Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "build_id",
    "legal_snapshot_sha256",
    "publication_id",
    "revision_id",
    "embedding_identity",
    "item_count",
    "items_sha256",
    "manifest_sha256"
  ],
  "title": "VectorIndexManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/embedding-vector-index.schema.json"
}
