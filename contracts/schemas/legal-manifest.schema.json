{
  "$defs": {
    "ClauseEffect": {
      "additionalProperties": false,
      "properties": {
        "article": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Article",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "end_status": {
          "default": "inherit",
          "enum": [
            "inherit",
            "unknown",
            "confirmed_open",
            "confirmed_end"
          ],
          "title": "End Status",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "note": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "article",
        "verification",
        "note"
      ],
      "title": "ClauseEffect",
      "type": "object"
    },
    "LegalVersion": {
      "additionalProperties": false,
      "properties": {
        "law_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Law Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "text_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text Path",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "source_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "source_snapshot_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Snapshot Path",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "captured_on": {
          "format": "date",
          "title": "Captured On",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "verified_through": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified Through"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective To"
        },
        "end_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "confirmed_open",
            "confirmed_end"
          ],
          "title": "End Status",
          "type": "string"
        },
        "clause_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClauseEffect"
          },
          "title": "Clause Effects",
          "type": "array"
        },
        "jurisdictions": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Jurisdictions",
          "type": "array"
        },
        "procurement_types": {
          "items": {
            "enum": [
              "government",
              "enterprise",
              "other"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Procurement Types",
          "type": "array"
        },
        "project_types": {
          "items": {
            "enum": [
              "works",
              "goods",
              "services"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Project Types",
          "type": "array"
        },
        "authority": {
          "enum": [
            "law",
            "regulation",
            "department_rule",
            "policy",
            "reference"
          ],
          "title": "Authority",
          "type": "string"
        },
        "verification_note": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Verification Note",
          "type": "string"
        }
      },
      "required": [
        "law_id",
        "title",
        "version",
        "text_path",
        "text_hash",
        "source_uri",
        "source_snapshot_path",
        "source_hash",
        "captured_on",
        "verification",
        "verified_through",
        "effective_from",
        "effective_to",
        "jurisdictions",
        "procurement_types",
        "project_types",
        "authority",
        "verification_note"
      ],
      "title": "LegalVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1alpha2",
      "default": "v1alpha2",
      "title": "Schema Version",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/LegalVersion"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "versions"
  ],
  "title": "LegalManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/legal-manifest.schema.json"
}
