{
  "$defs": {
    "Excluded": {
      "additionalProperties": false,
      "properties": {
        "law_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Law Id"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "reasons": {
          "items": {
            "enum": [
              "not_yet_effective",
              "expired",
              "jurisdiction_mismatch",
              "procurement_mismatch",
              "project_type_mismatch",
              "unverified",
              "outside_verification_horizon",
              "unlocated",
              "no_text_match",
              "context_incomplete"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "reasons"
      ],
      "title": "Excluded",
      "type": "object"
    },
    "LegalHit": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "law_id": {
          "title": "Law Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Article"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_hash": {
          "title": "Quote Hash",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "text_hash": {
          "title": "Text Hash",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective To"
        },
        "version_status": {
          "enum": [
            "verified_current",
            "verified_historical",
            "unverified"
          ],
          "title": "Version Status",
          "type": "string"
        },
        "eligible_for_confirmation": {
          "title": "Eligible For Confirmation",
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "valid",
            "unverified",
            "outside_verification_horizon",
            "unlocated"
          ],
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "law_id",
        "title",
        "article",
        "version",
        "quote",
        "quote_hash",
        "source_uri",
        "source_hash",
        "text_hash",
        "locator",
        "effective_from",
        "effective_to",
        "version_status",
        "eligible_for_confirmation",
        "reason",
        "score"
      ],
      "title": "LegalHit",
      "type": "object"
    },
    "RetrievalQuery": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "review_date": {
          "format": "date",
          "title": "Review Date",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "include_references": {
          "default": false,
          "title": "Include References",
          "type": "boolean"
        },
        "schema_version": {
          "const": "v1alpha2",
          "default": "v1alpha2",
          "title": "Schema Version",
          "type": "string"
        },
        "region": {
          "enum": [
            "CN",
            "CN/上海",
            "CN/云南",
            "CN/内蒙古",
            "CN/北京",
            "CN/台湾",
            "CN/吉林",
            "CN/四川",
            "CN/天津",
            "CN/宁夏",
            "CN/安徽",
            "CN/山东",
            "CN/山西",
            "CN/广东",
            "CN/广东/广州",
            "CN/广东/深圳",
            "CN/广西",
            "CN/新疆",
            "CN/江苏",
            "CN/江西",
            "CN/河北",
            "CN/河南",
            "CN/浙江",
            "CN/海南",
            "CN/湖北",
            "CN/湖南",
            "CN/澳门",
            "CN/甘肃",
            "CN/福建",
            "CN/福建/三明",
            "CN/福建/南平",
            "CN/福建/厦门",
            "CN/福建/宁德",
            "CN/福建/泉州",
            "CN/福建/漳州",
            "CN/福建/福州",
            "CN/福建/莆田",
            "CN/福建/龙岩",
            "CN/西藏",
            "CN/贵州",
            "CN/辽宁",
            "CN/重庆",
            "CN/陕西",
            "CN/青海",
            "CN/香港",
            "CN/黑龙江"
          ],
          "maxLength": 200,
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "procurement_type": {
          "enum": [
            "government",
            "enterprise",
            "other"
          ],
          "title": "Procurement Type",
          "type": "string"
        },
        "project_type": {
          "enum": [
            "works",
            "goods",
            "services"
          ],
          "title": "Project Type",
          "type": "string"
        }
      },
      "required": [
        "text",
        "review_date",
        "region",
        "procurement_type",
        "project_type"
      ],
      "title": "RetrievalQuery",
      "type": "object"
    },
    "RunSnapshot": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Run Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "context_version": {
          "minimum": 1,
          "title": "Context Version",
          "type": "integer"
        },
        "context_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Hash",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "review_date": {
          "format": "date",
          "title": "Review Date",
          "type": "string"
        },
        "review_date_source": {
          "const": "explicit_actor_input",
          "default": "explicit_actor_input",
          "title": "Review Date Source",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "tenant_id",
        "project_id",
        "actor_id",
        "context_version",
        "context_hash",
        "request_hash",
        "review_date",
        "created_at"
      ],
      "title": "RunSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "context_incomplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "query": {
            "type": "null"
          },
          "hits": {
            "maxItems": 0
          },
          "context_error": {
            "enum": [
              "REGION_UNMAPPED",
              "CONTEXT_INVALID"
            ]
          },
          "excluded": {
            "minItems": 1
          }
        },
        "required": [
          "context_error",
          "excluded"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "type": "object"
          },
          "context_error": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "v1alpha2",
      "default": "v1alpha2",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "retrieval_version": {
      "const": "bm25-char-cosine-rrf-2",
      "default": "bm25-char-cosine-rrf-2",
      "title": "Retrieval Version",
      "type": "string"
    },
    "normalization_version": {
      "const": "cn-regions-1",
      "default": "cn-regions-1",
      "title": "Normalization Version",
      "type": "string"
    },
    "status": {
      "default": "complete",
      "enum": [
        "complete",
        "context_incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "context_error": {
      "anyOf": [
        {
          "enum": [
            "REGION_UNMAPPED",
            "CONTEXT_INVALID"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Error"
    },
    "query": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalQuery"
        },
        {
          "type": "null"
        }
      ]
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/LegalHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "excluded": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Excluded"
      },
      "title": "Excluded",
      "type": "array"
    },
    "run_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "snapshot_hash",
    "query",
    "hits"
  ],
  "title": "RetrievalResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/legal-result.schema.json"
}
