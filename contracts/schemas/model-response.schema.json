{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/model-response.schema.json",
  "title": "ModelResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["call_id", "provider", "model", "profile", "content", "usage", "latency_ms", "response_hash"],
  "properties": {
    "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 100},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "profile": {"type": "string", "minLength": 1, "maxLength": 100},
    "content": {"type": "object"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "latency_ms": {"type": "integer", "minimum": 0},
    "response_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "finish_reason": {"type": ["string", "null"], "maxLength": 100}
  }
}

