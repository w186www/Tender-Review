{
  "$defs": {
    "Fragment": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "page": {
                "minimum": 1,
                "type": "integer"
              },
              "bbox": {
                "items": {
                  "minimum": 0,
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              }
            },
            "required": [
              "page",
              "bbox"
            ]
          },
          "if": {
            "properties": {
              "coordinate_system": {
                "const": "ooxml"
              }
            },
            "required": [
              "coordinate_system"
            ]
          },
          "then": {
            "properties": {
              "page": {
                "type": "null"
              },
              "bbox": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table_cell"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "table": {
                "minimum": 0,
                "type": "integer"
              },
              "row": {
                "minimum": 0,
                "type": "integer"
              },
              "column": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "table",
              "row",
              "column"
            ]
          }
        }
      ],
      "properties": {
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "coordinate_system": {
          "enum": [
            "pdf_points",
            "image_pixels",
            "ooxml"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paragraph",
            "table_cell",
            "ocr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "default": "",
          "maxLength": 300,
          "title": "Section",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "source": {
          "enum": [
            "native",
            "ocr",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "ocr_words": {
          "items": {
            "$ref": "#/$defs/OCRWordRecord"
          },
          "maxItems": 10000,
          "title": "Ocr Words",
          "type": "array"
        },
        "table": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        }
      },
      "required": [
        "locator",
        "coordinate_system",
        "kind",
        "text",
        "text_sha256",
        "source"
      ],
      "title": "Fragment",
      "type": "object"
    },
    "JsonValue": {},
    "OCRRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "v1alpha1",
          "default": "v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "engine_id": {
          "const": "tesseract",
          "default": "tesseract",
          "title": "Engine Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Model Ids",
          "type": "array"
        },
        "model_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Sha256",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parser_image_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Image Sha256"
        },
        "identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        }
      },
      "required": [
        "engine_version",
        "model_ids",
        "model_sha256",
        "parameters",
        "identity_sha256"
      ],
      "title": "OCRRuntimeIdentity",
      "type": "object"
    },
    "OCRWordRecord": {
      "additionalProperties": false,
      "description": "One Tesseract TSV word with both source-pixel and document coordinates.",
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "page_num": {
          "maximum": 300,
          "minimum": 1,
          "title": "Page Num",
          "type": "integer"
        },
        "tsv_page_num": {
          "maximum": 300,
          "minimum": 1,
          "title": "Tsv Page Num",
          "type": "integer"
        },
        "block_num": {
          "minimum": 0,
          "title": "Block Num",
          "type": "integer"
        },
        "par_num": {
          "minimum": 0,
          "title": "Par Num",
          "type": "integer"
        },
        "line_num": {
          "minimum": 0,
          "title": "Line Num",
          "type": "integer"
        },
        "word_num": {
          "minimum": 0,
          "title": "Word Num",
          "type": "integer"
        },
        "raw_left": {
          "minimum": 0,
          "title": "Raw Left",
          "type": "integer"
        },
        "raw_top": {
          "minimum": 0,
          "title": "Raw Top",
          "type": "integer"
        },
        "raw_width": {
          "minimum": 0,
          "title": "Raw Width",
          "type": "integer"
        },
        "raw_height": {
          "minimum": 0,
          "title": "Raw Height",
          "type": "integer"
        },
        "raw_confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Raw Confidence",
          "type": "number"
        }
      },
      "required": [
        "text",
        "confidence",
        "bbox",
        "level",
        "page_num",
        "tsv_page_num",
        "block_num",
        "par_num",
        "line_num",
        "word_num",
        "raw_left",
        "raw_top",
        "raw_width",
        "raw_height",
        "raw_confidence"
      ],
      "title": "OCRWordRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1alpha1",
      "default": "v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "format": {
      "enum": [
        "pdf",
        "docx",
        "png",
        "jpeg"
      ],
      "title": "Format",
      "type": "string"
    },
    "page_count": {
      "anyOf": [
        {
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/Fragment"
      },
      "maxItems": 10000,
      "title": "Fragments",
      "type": "array"
    },
    "quality": {
      "enum": [
        "passed",
        "requires_review"
      ],
      "title": "Quality",
      "type": "string"
    },
    "issues": {
      "items": {
        "enum": [
          "TYPE_MISMATCH",
          "SIZE_LIMIT",
          "MALICIOUS_CONTENT",
          "ARCHIVE_LIMIT",
          "INVALID_FILE",
          "ENCRYPTED_FILE",
          "PAGE_LIMIT",
          "IMAGE_LIMIT",
          "TEXT_LIMIT",
          "OCR_LIMIT",
          "LOW_QUALITY",
          "LOW_CONFIDENCE_NUMERIC",
          "DUPLICATE_TEXT",
          "PAGE_COVERAGE_GAP",
          "READING_ORDER_GAP",
          "TABLE_STRUCTURE_GAP",
          "INVALID_DATE",
          "SCANNER_UNAVAILABLE",
          "SCANNER_STALE",
          "PARSE_TIMEOUT",
          "PARSE_FAILED",
          "HASH_MISMATCH",
          "ACTOR_FORBIDDEN",
          "OUTPUT_LIMIT"
        ],
        "type": "string"
      },
      "maxItems": 20,
      "title": "Issues",
      "type": "array"
    },
    "ocr_runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/OCRRuntimeIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source_hash",
    "format",
    "fragments",
    "quality",
    "issues"
  ],
  "title": "ParsedDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/parsed-document.schema.json"
}
