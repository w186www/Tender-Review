{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/review-report.schema.json",
  "title": "ImmutableReviewReportContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "project_id", "review_task_id", "run_id", "result_id", "snapshot_hash", "report_id", "template_version", "generated_at", "input_snapshot", "findings"],
  "properties": {
    "schema_version": {"const": "task0010-report.v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "project_name": {"type": ["string", "null"], "maxLength": 300},
    "review_task_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "run_id": {"type": "string", "format": "uuid"},
    "result_id": {"type": "string", "format": "uuid"},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_id": {"type": "string", "format": "uuid"},
    "template_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "generated_at": {"type": "string", "format": "date-time"},
    "input_snapshot": {"type": "object"},
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["finding_id", "category", "title", "description", "severity", "evidence_status", "review_status", "recommendation", "evidence", "citations"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "category": {"type": "string", "enum": ["qualification", "technical", "evaluation", "contract", "procedure"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "evidence_status": {"type": "string", "enum": ["candidate", "confirmed", "suspected", "insufficient_evidence"]},
          "review_status": {"type": "string", "enum": ["accepted", "modified", "rejected"]},
          "recommendation": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
          "human_review": {"type": "object"},
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "raw_source_sha256", "parse_version", "section_id", "section_revision", "locator", "page", "coordinate_system", "quote", "quote_sha256"],
              "properties": {
                "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "raw_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "parse_version": {"type": "integer", "minimum": 1},
                "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "section_revision": {"type": "integer", "minimum": 0},
                "locator": {"type": "string", "minLength": 1, "maxLength": 500},
                "page": {"type": ["integer", "null"], "minimum": 1},
                "coordinate_system": {"type": "string", "enum": ["pdf_points", "image_pixels", "ooxml"]},
                "bbox": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
                "quote": {"type": "string", "minLength": 1, "maxLength": 8000},
                "quote_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
