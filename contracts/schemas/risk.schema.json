{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidding-compliance.local/schemas/risk.schema.json",
  "title": "ComplianceFinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "category",
    "title",
    "description",
    "severity",
    "evidence_status",
    "review_status",
    "source_excerpt",
    "sources",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "category": {
      "type": "string",
      "enum": [
        "qualification",
        "technical",
        "evaluation",
        "contract",
        "procedure"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "candidate",
        "confirmed",
        "suspected",
        "insufficient_evidence"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "modified",
        "rejected"
      ]
    },
    "source_excerpt": {
      "allOf": [
        {
          "$ref": "evidence.schema.json"
        },
        {
          "properties": {
            "kind": {
              "const": "document"
            }
          },
          "anyOf": [
            {
              "required": [
                "page"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "required": [
                "locator"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "rule",
          "retrieval",
          "model",
          "human"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "assessment",
          "summary"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "model",
              "retrieval"
            ]
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "legal_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "law_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 500},
          "quote_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "text_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "official_source_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
          "official_source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "official_source_locator": {"type": "string", "minLength": 1, "maxLength": 2500},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "eligible_for_confirmation": {"type": "boolean"},
          "reason": {
            "type": "string",
            "enum": [
              "valid",
              "unverified",
              "outside_verification_horizon",
              "unlocated",
              "unknown_end",
              "clause_unverified",
              "extraction_unverified",
              "applicability_unverified"
            ]
          },
          "applicable": {"type": "boolean"},
          "applicability_status": {"type": "string", "enum": ["verified", "unverified"]},
          "applicable_frameworks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["tendering", "government_procurement"]}
          },
          "adoption_status": {"type": "string", "enum": ["project_adopted", "not_adopted"]},
          "adoption_policy_id": {"type": ["string", "null"], "maxLength": 128},
          "confirmation_reason": {"type": "string", "maxLength": 200}
        },
        "additionalProperties": true
      },
      "description": "Retrieved clauses shown as references only: revalidated against the frozen publication but never confirmable and never counted as evidence."
    },
    "rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "reasoning_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "recommendation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "decided_at",
        "reason"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_status": {
            "const": "confirmed"
          }
        },
        "required": [
          "evidence_status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "required": [
                "kind",
                "version_status",
                "article"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "law",
                    "policy",
                    "internal_rule"
                  ]
                },
                "version_status": {
                  "enum": [
                    "verified_current",
                    "verified_historical"
                  ]
                },
                "article": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "accepted",
              "modified",
              "rejected"
            ]
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "human_review"
        ]
      }
    }
  ]
}
