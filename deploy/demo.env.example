# Template for deploy/.env (never commit the generated file).
# deploy/bootstrap.sh creates deploy/.env from this template with generated secrets.
#
# Application-visible settings are the same variables the repository already documents in
# .env.example and docs/development/*; nothing new is invented here.

# ---------------------------------------------------------------- runtime
# staging keeps the interactive API docs disabled while still failing closed on
# development-only shortcuts (local object storage is refused outside development/test).
APP_ENV=staging
APP_LOG_LEVEL=INFO
# Public origin the browser uses; only affects absolute URL generation.
PUBLIC_BASE_URL=http://localhost
# nginx bind address. Loopback keeps the login page off the internet until TLS and access
# protection exist; the TLS overlay publishes 80/443 itself.
HTTP_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=
IMAGE_TAG=demo
# Names the Docker volumes; change to run two independent stacks on one host.
VOLUME_PREFIX=tender-review

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=bidding_compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
# Non-superuser, NOBYPASSRLS role the application and the worker connect with. The code
# refuses to run application operations as a superuser (persistence/database.py).
DEMO_DB_RUNTIME_USER=tender_runtime
DEMO_DB_RUNTIME_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgresql+psycopg://tender_runtime:REPLACE_WITH_GENERATED_SECRET@postgres:5432/bidding_compliance
# Used by the initialisation step only.
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_GENERATED_SECRET@postgres:5432/bidding_compliance

# ---------------------------------------------------------------- object storage
OBJECT_STORAGE_BUCKET=bidding-compliance
MINIO_ROOT_USER=REPLACE_WITH_GENERATED_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# ---------------------------------------------------------------- identity
# Must be at least 32 bytes; the application rejects shorter keys.
AUTH_SIGNING_KEY=REPLACE_WITH_GENERATED_SECRET
AUTH_ISSUER=bidding-compliance
AUTH_AUDIENCE=bidding-api
AUTH_TTL_SECONDS=900

# ---------------------------------------------------------------- demo accounts
# DEMO_TENANT must stay tenant-a: the repository's queue-draining worker
# (scripts/run_offline_demo_worker.py) only serves that tenant.
DEMO_TENANT=tenant-a
DEMO_TENANT_NAME=面试演示租户
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DEMO_REVIEWER_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DEMO_AUDITOR_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# ---------------------------------------------------------------- parsing and scanning
# Filled by deploy/bootstrap.sh with the docker image ID (sha256:...) of the parser image.
PARSER_IMAGE=
# Group ID of /var/run/docker.sock, detected by deploy/bootstrap.sh so the non-root worker
# may reach it. Falls back to 0 when detection is not possible.
DOCKER_SOCKET_GID=0
CLAMD_TIMEOUT_SECONDS=20
# 7 days is the maximum the configuration accepts; a stale database blocks uploads.
CLAMD_MAX_DATABASE_AGE_SECONDS=604800

# ---------------------------------------------------------------- review executor
# offline           deterministic protocol gateway; no supplier request is possible
# authorized-real   repository's authorized Qwen gateway; requires the model variables below
DEPLOY_REVIEW_MODE=offline
# Compile-time switch of the workbench banner; must match DEPLOY_REVIEW_MODE.
# offline-deterministic | online-qwen | dec005-real-qwen
VITE_REVIEW_MODE=offline-deterministic

# ---------------------------------------------------------------- public exposure / TLS
# The public IPv4 the certificate is issued for. Let's Encrypt IP certificates are
# short-lived (about 6 days) and limited to 5 per IP per 7 days.
PUBLIC_IP=
# Optional ACME account contact. Left empty, the account is registered without an email
# (no expiry reminders from Let's Encrypt; renewal is automatic either way).
ACME_EMAIL=
# Which nginx configuration the public overlay mounts:
#   nginx-acme.conf      challenge path only, used before a certificate exists
#   nginx-demo-tls.conf  HTTPS service, used after deploy/certbot.sh deploy
NGINX_CONF=nginx-acme.conf
# Directory holding the deployed certificate as REAL files (never certbot's live/ symlinks).
TLS_CERT_DIR=./certs

# ---------------------------------------------------------------- real model (only for DEPLOY_REVIEW_MODE=authorized-real)
# Not configured by this template: the repository gates supplier calls behind an explicit
# authorization identity, a document-hash allowlist, a spend ceiling and an audit trail.
# See deploy/README-demo.md, section "真实 Qwen 审查".
#DASHSCOPE_API_KEY=
#BAILIAN_WORKSPACE_ID=
#DEC005_AUTHORIZATION_ID=
#DEC005_ALLOWED_SYNTHETIC_SHA256=
#DEC005_ALLOWED_DOCUMENT_SHA256=
