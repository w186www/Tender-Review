{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "recommended"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/src/api/schema.d.ts",
			"!**/dist",
			"!**/node_modules"
		]
	}
}
