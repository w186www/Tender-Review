{
  "name": "bidding-compliance-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src scripts vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.check.d.ts && node scripts/check-api-types.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "openapi-typescript": "^7.0.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
